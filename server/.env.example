# PostgreSQL (Neon: https://neon.tech -> create project -> connection string)
DATABASE_URL="postgresql://USER:PASSWORD@HOST/DB?sslmode=require"

# JWT secrets (use long random strings)
JWT_ACCESS_SECRET="change-me-access"
JWT_REFRESH_SECRET="change-me-refresh"
JWT_ACCESS_TTL="15m"
JWT_REFRESH_TTL="30d"

# ImageKit (media) — Dashboard -> Developer -> API Keys
IMAGEKIT_PUBLIC_KEY="public_xxx"
IMAGEKIT_PRIVATE_KEY="private_xxx"
IMAGEKIT_URL_ENDPOINT="https://ik.imagekit.io/your_id"

# Server
PORT=4000
CORS_ORIGINS="http://localhost:3000"

# Public website origin — used for absolute URLs in sitemap.xml and link previews.
SITE_URL="http://localhost:3000"

# Hosting without a file system? Paste the service-account JSON (raw or base64)
# here instead of using FIREBASE_SERVICE_ACCOUNT_PATH. Optional: without either,
# the API runs with push notifications disabled.
# FIREBASE_SERVICE_ACCOUNT=

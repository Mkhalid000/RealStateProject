generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  user
  agent
  admin
}

enum PropertyType {
  apartment
  villa
  plot
  commercial
  office
  shop
}

enum ListingType {
  buy
  rent
}

enum Furnishing {
  unfurnished
  semi_furnished
  furnished
}

enum Facing {
  north
  south
  east
  west
  north_east
  north_west
  south_east
  south_west
}

enum VerificationStatus {
  pending
  verified
  rejected
}

enum PropertyStatus {
  active
  sold
  rented
  draft
}

enum NotificationType {
  like
  comment
  message
  follow
  new_reel
  property_status
  new_property
  saved_search_match
}

enum SubscriptionPlan {
  free
  pro
  premium
}

enum BoostStatus {
  pending
  active
  expired
}

enum SubscriptionStatus {
  active
  cancelled
  expired
}

/// house  = own promo creative (image + copy + CTA)
/// sponsored = promotes an existing Property into an ad slot
enum AdKind {
  house
  sponsored
}

/// Whether the campaign is eligible at all. "scheduled" and "expired" are not
/// stored — they're derived from startsAt/endsAt so state can't go stale.
enum AdStatus {
  draft
  active
  paused
}

model User {
  id                 String             @id @default(uuid())
  email              String             @unique
  passwordHash       String
  role               UserRole           @default(user)
  fullName           String?
  bio                String?
  avatarUrl          String?
  phone              String?
  socialLinks        Json?
  isVerified         Boolean            @default(false)
  verificationStatus VerificationStatus @default(pending)
  isActive           Boolean            @default(true)
  createdAt          DateTime           @default(now())
  updatedAt          DateTime           @updatedAt

  properties    Property[]
  reels         Reel[]
  likes         Like[]
  comments      Comment[]
  following     Follow[]        @relation("follower")
  followers     Follow[]        @relation("agent")
  savedProps    SavedProperty[]
  notifications Notification[]
  deviceTokens  DeviceToken[]
  refreshTokens RefreshToken[]
  boosts        Boost[]
  subscription  Subscription?
  convsAsUser   Conversation[]  @relation("convUser")
  convsAsAgent  Conversation[]  @relation("convAgent")
  messages      Message[]
  blogPosts     BlogPost[]
  blogComments  BlogComment[]
  blogLikes     BlogLike[]
  savedSearches SavedSearch[]

  @@index([role])
}

/// A device's FCM push token (one user can have several devices).
model DeviceToken {
  id        String   @id @default(uuid())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId    String
  token     String   @unique
  platform  String   @default("android")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
}

model RefreshToken {
  id        String   @id @default(uuid())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId    String
  tokenHash String
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([userId])
}

model Property {
  id      String @id @default(uuid())
  agent   User   @relation(fields: [agentId], references: [id], onDelete: Cascade)
  agentId String

  // Step 1 — basic
  title           String
  slug            String       @unique
  type            PropertyType @default(apartment)
  listingType     ListingType  @default(buy)
  description     String?
  price           Decimal      @default(0) @db.Decimal(14, 2)
  currency        String       @default("USD")
  priceNegotiable Boolean      @default(false)
  featured        Boolean      @default(false)

  // Step 2 — location
  country      String?
  state        String?
  city         String?
  locality     String?
  address      String?
  landmark     String?
  pincode      String?
  latitude     Float?
  longitude    Float?
  locationText String?

  // Step 3 — specifications
  bhk              Int?
  bathrooms        Int?
  balconies        Int?
  superBuiltUpArea Float?
  carpetArea       Float?
  plotArea         Float?
  floorNumber      Int?
  totalFloors      Int?
  propertyAge      String?
  furnishing       Furnishing?
  facing           Facing?

  // Step 4 — amenities
  amenities String[] @default([])

  // Step 5 — media
  imageUrls      String[] @default([])
  videoUrl       String?
  virtualTourUrl String?
  modelUrl       String?
  brochureUrl    String?

  // Step 6 — owner / agent
  ownerName     String?
  ownerPhone    String?
  ownerWhatsapp String?
  ownerEmail    String?
  agencyName    String?

  // meta + verification
  status             PropertyStatus     @default(active)
  isVerified         Boolean            @default(false)
  verificationStatus VerificationStatus @default(pending)
  createdAt          DateTime           @default(now())
  updatedAt          DateTime           @updatedAt

  reels       Reel[]
  savedBy     SavedProperty[]
  leads       Lead[]
  adCampaigns AdCampaign[]
  blogPosts   BlogPostProperty[]

  @@index([agentId])
  @@index([type])
  @@index([price])
  @@index([isVerified])
}

model Lead {
  id         String    @id @default(uuid())
  name       String
  email      String?
  phone      String?
  message    String?
  source     String    @default("website") // website | mobile
  status     String    @default("new") // new | contacted | closed
  property   Property? @relation(fields: [propertyId], references: [id], onDelete: SetNull)
  propertyId String?
  createdAt  DateTime  @default(now())

  @@index([source, createdAt])
  @@index([status])
}

model Reel {
  id             String    @id @default(uuid())
  agent          User      @relation(fields: [agentId], references: [id], onDelete: Cascade)
  agentId        String
  videoUrl       String
  thumbnailUrl   String?
  caption        String?
  property       Property? @relation(fields: [propertyId], references: [id], onDelete: SetNull)
  propertyId     String?
  isBoosted      Boolean   @default(false)
  boostExpiresAt DateTime?
  viewCount      Int       @default(0)
  likeCount      Int       @default(0)
  commentCount   Int       @default(0)
  createdAt      DateTime  @default(now())

  likes    Like[]
  comments Comment[]
  boosts   Boost[]

  @@index([agentId])
  @@index([isBoosted, createdAt])
}

model Like {
  reel      Reel     @relation(fields: [reelId], references: [id], onDelete: Cascade)
  reelId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId    String
  createdAt DateTime @default(now())

  @@id([reelId, userId])
}

model Comment {
  id        String   @id @default(uuid())
  reel      Reel     @relation(fields: [reelId], references: [id], onDelete: Cascade)
  reelId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId    String
  text      String
  createdAt DateTime @default(now())

  @@index([reelId, createdAt])
}

model Follow {
  follower   User     @relation("follower", fields: [followerId], references: [id], onDelete: Cascade)
  followerId String
  agent      User     @relation("agent", fields: [agentId], references: [id], onDelete: Cascade)
  agentId    String
  createdAt  DateTime @default(now())

  @@id([followerId, agentId])
  @@index([agentId])
}

model Conversation {
  id            String    @id @default(uuid())
  user          User      @relation("convUser", fields: [userId], references: [id], onDelete: Cascade)
  userId        String
  agent         User      @relation("convAgent", fields: [agentId], references: [id], onDelete: Cascade)
  agentId       String
  lastMessage   String?
  lastMessageAt DateTime?
  userReadAt    DateTime?
  agentReadAt   DateTime?
  createdAt     DateTime  @default(now())

  messages Message[]

  @@unique([userId, agentId])
}

model Message {
  id             String       @id @default(uuid())
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  conversationId String
  sender         User         @relation(fields: [senderId], references: [id], onDelete: Cascade)
  senderId       String
  text           String
  createdAt      DateTime     @default(now())

  @@index([conversationId, createdAt])
}

model SavedProperty {
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId     String
  property   Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  propertyId String
  createdAt  DateTime @default(now())

  @@id([userId, propertyId])
}

model Notification {
  id        String           @id @default(uuid())
  user      User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId    String
  type      NotificationType
  payload   Json             @default("{}")
  readAt    DateTime?
  createdAt DateTime         @default(now())

  @@index([userId, createdAt])
}

model Boost {
  id        String      @id @default(uuid())
  reel      Reel        @relation(fields: [reelId], references: [id], onDelete: Cascade)
  reelId    String
  agent     User        @relation(fields: [agentId], references: [id], onDelete: Cascade)
  agentId   String
  amount    Decimal     @default(0) @db.Decimal(10, 2)
  days      Int         @default(7)
  status    BoostStatus @default(pending)
  startsAt  DateTime?
  expiresAt DateTime?
  createdAt DateTime    @default(now())

  @@index([agentId])
  @@index([status])
}

/// An admin-managed advertising campaign. Either a house promo (its own
/// creative) or a sponsored listing (renders an existing Property as an ad).
model AdCampaign {
  id     String   @id @default(uuid())
  name   String
  kind   AdKind   @default(house)
  status AdStatus @default(draft)

  // ---- creative (house ads) ----
  headline String?
  body     String?
  imageUrl String?
  ctaLabel String?
  ctaUrl   String?

  // ---- sponsored listing ----
  property   Property? @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  propertyId String?

  // ---- placement ----
  /// Slot keys this campaign may fill, e.g. ["properties_sidebar"].
  slots    String[] @default([])
  /// Higher wins. Ties are broken by weighted random using `weight`.
  priority Int      @default(0)
  weight   Int      @default(1)

  // ---- schedule ----
  startsAt DateTime?
  endsAt   DateTime?

  // ---- presentation ----
  /// Hex accent the creative is tinted with. Null = the site's gold.
  accent        String?
  /// Show a live countdown to endsAt (only meaningful with an end date).
  showCountdown Boolean @default(false)
  /// Whether the viewer can close a modal/floating unit.
  dismissible   Boolean @default(true)

  // ---- how interrupting placements appear ----
  /// immediate | delay | scroll | exit_intent
  trigger      String @default("delay")
  /// seconds for `delay`, scroll percent for `scroll`, ignored otherwise
  triggerValue Int    @default(8)
  /// always | session | daily — how often one viewer may see it again
  frequency    String @default("session")

  // ---- delivery caps ----
  maxImpressions Int?
  dailyCap       Int?

  // ---- targeting (empty / null = no restriction) ----
  targetCities         String[] @default([])
  targetTypes          String[] @default([])
  targetListingType    String?
  /// Blog category slugs the campaign is restricted to.
  targetBlogCategories String[] @default([])
  /// Blog tags the campaign is restricted to.
  targetTags           String[] @default([])
  /// all | mobile | desktop
  targetDevice         String?
  /// all | guest | user | agent
  targetAudience       String?

  // ---- lifetime totals (per-day breakdown lives in AdDailyStat) ----
  impressions Int @default(0)
  clicks      Int @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  stats AdDailyStat[]

  @@index([status])
  @@index([propertyId])
}

/// Aggregated daily counters. Deliberately not one row per impression — this
/// stays small enough for the free-tier database no matter the traffic.
model AdDailyStat {
  id         String     @id @default(uuid())
  campaign   AdCampaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  campaignId String
  date       DateTime   @db.Date
  slot       String

  impressions Int @default(0)
  clicks      Int @default(0)

  @@unique([campaignId, date, slot])
  @@index([date])
}

model Subscription {
  id               String             @id @default(uuid())
  agent            User               @relation(fields: [agentId], references: [id], onDelete: Cascade)
  agentId          String             @unique
  plan             SubscriptionPlan   @default(free)
  status           SubscriptionStatus @default(active)
  currentPeriodEnd DateTime?
  createdAt        DateTime           @default(now())
  updatedAt        DateTime           @updatedAt
}

// ══════════════════════════════════════════════════════════════════
//  Blog
// ══════════════════════════════════════════════════════════════════

enum BlogStatus {
  draft
  scheduled
  published
  archived
}

/// Editorial categories. A table rather than an enum so the admin can add one
/// without a migration.
model BlogCategory {
  id            String  @id @default(uuid())
  name          String
  slug          String  @unique
  description   String?
  coverImageUrl String?
  /// Manual ordering in the category rail; lower shows first.
  position      Int     @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  posts BlogPost[]
}

model BlogPost {
  id       String @id @default(uuid())
  author   User   @relation(fields: [authorId], references: [id], onDelete: Cascade)
  authorId String

  // ---- content ----
  title          String
  slug           String   @unique
  excerpt        String?
  /// Markdown. Rendered on the site; the admin editor writes it.
  content        String   @default("")
  coverImageUrl  String?
  imageUrls      String[] @default([])
  videoUrl       String?
  /// Estimated from the word count on save.
  readingMinutes Int      @default(1)

  // ---- taxonomy ----
  category   BlogCategory? @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  categoryId String?
  tags       String[]      @default([])

  /// Bylines for writers who don't have an account.
  guestAuthorName   String?
  guestAuthorAvatar String?

  // ---- publishing / moderation ----
  status             BlogStatus         @default(draft)
  publishedAt        DateTime?
  scheduledFor       DateTime?
  featured           Boolean            @default(false)
  pinned             Boolean            @default(false)
  /// Agent-written posts wait for an admin, exactly like listings do.
  isVerified         Boolean            @default(false)
  verificationStatus VerificationStatus @default(pending)

  // ---- SEO ----
  metaTitle       String?
  metaDescription String?
  ogImageUrl      String?
  canonicalUrl    String?
  noIndex         Boolean @default(false)

  // ---- real-estate context (drives "articles for your city") ----
  country       String?
  state         String?
  city          String?
  locality      String?
  propertyTypes String[] @default([])

  // ---- advertising ----
  /// Advertorial: the whole post is paid for, and says so.
  isSponsored            Boolean   @default(false)
  sponsorName            String?
  sponsorLogoUrl         String?
  sponsorUrl             String?
  sponsorDisclosure      String?
  /// Let the normal ad slots run inside this post.
  adsEnabled             Boolean   @default(true)
  /// Where the first inline unit lands, and how many may appear.
  inlineAdAfterParagraph Int       @default(4)
  maxInlineAds           Int       @default(2)
  /// End-of-article call to action.
  ctaLabel               String?
  ctaUrl                 String?
  /// Paid top placement in the index, same shape as a boosted reel.
  isPromoted             Boolean   @default(false)
  promotedUntil          DateTime?

  // ---- engagement ----
  allowComments Boolean @default(true)
  viewCount     Int     @default(0)
  likeCount     Int     @default(0)
  commentCount  Int     @default(0)
  shareCount    Int     @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  comments          BlogComment[]
  likes             BlogLike[]
  stats             BlogDailyStat[]
  relatedProperties BlogPostProperty[]

  @@index([status, publishedAt])
  @@index([categoryId])
  @@index([authorId])
  @@index([city])
}

/// Explicit join table so the pairing can carry its own ordering.
model BlogPostProperty {
  post       BlogPost @relation(fields: [postId], references: [id], onDelete: Cascade)
  postId     String
  property   Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  propertyId String
  position   Int      @default(0)

  @@id([postId, propertyId])
  @@index([propertyId])
}

model BlogComment {
  id         String        @id @default(uuid())
  post       BlogPost      @relation(fields: [postId], references: [id], onDelete: Cascade)
  postId     String
  user       User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId     String
  text       String
  /// Replies are one level deep — a thread under a top-level comment.
  parent     BlogComment?  @relation("BlogCommentThread", fields: [parentId], references: [id], onDelete: Cascade)
  parentId   String?
  replies    BlogComment[] @relation("BlogCommentThread")
  /// Comments are held until an admin approves them.
  isApproved Boolean       @default(false)
  createdAt  DateTime      @default(now())

  @@index([postId, createdAt])
  @@index([isApproved])
}

model BlogLike {
  post      BlogPost @relation(fields: [postId], references: [id], onDelete: Cascade)
  postId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId    String
  createdAt DateTime @default(now())

  @@id([postId, userId])
}

/// Same aggregate-by-day approach as AdDailyStat — one row per post per day.
model BlogDailyStat {
  id     String   @id @default(uuid())
  post   BlogPost @relation(fields: [postId], references: [id], onDelete: Cascade)
  postId String
  date   DateTime @db.Date

  views  Int @default(0)
  reads  Int @default(0)
  likes  Int @default(0)
  shares Int @default(0)

  @@unique([postId, date])
  @@index([date])
}

/// A filter set a visitor asked us to remember. `query` is the same query
/// string the listings page uses, so running one is just a redirect.
model SavedSearch {
  id     String @id @default(uuid())
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId String

  name  String
  /// e.g. "city=Bhopal&type=villa&maxPrice=9000000"
  query String

  /// Alert the user when a new listing matches.
  alertsEnabled Boolean   @default(true)
  lastAlertAt   DateTime?
  /// How many matches have been announced since the search was created.
  matchCount    Int       @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
  @@index([alertsEnabled])
}

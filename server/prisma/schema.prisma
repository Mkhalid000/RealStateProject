generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  user
  agent
  admin
}

enum PropertyType {
  apartment
  villa
  plot
  commercial
  office
  shop
}

enum ListingType {
  buy
  rent
}

enum Furnishing {
  unfurnished
  semi_furnished
  furnished
}

enum Facing {
  north
  south
  east
  west
  north_east
  north_west
  south_east
  south_west
}

enum VerificationStatus {
  pending
  verified
  rejected
}

enum PropertyStatus {
  active
  sold
  rented
  draft
}

enum NotificationType {
  like
  comment
  message
  follow
  new_reel
  property_status
  new_property
}

enum SubscriptionPlan {
  free
  pro
  premium
}

enum BoostStatus {
  pending
  active
  expired
}

enum SubscriptionStatus {
  active
  cancelled
  expired
}

model User {
  id                 String             @id @default(uuid())
  email              String             @unique
  passwordHash       String
  role               UserRole           @default(user)
  fullName           String?
  bio                String?
  avatarUrl          String?
  phone              String?
  socialLinks        Json?
  isVerified         Boolean            @default(false)
  verificationStatus VerificationStatus @default(pending)
  isActive           Boolean            @default(true)
  createdAt          DateTime           @default(now())
  updatedAt          DateTime           @updatedAt

  properties    Property[]
  reels         Reel[]
  likes         Like[]
  comments      Comment[]
  following     Follow[]        @relation("follower")
  followers     Follow[]        @relation("agent")
  savedProps    SavedProperty[]
  notifications Notification[]
  deviceTokens  DeviceToken[]
  refreshTokens RefreshToken[]
  boosts        Boost[]
  subscription  Subscription?
  convsAsUser   Conversation[]  @relation("convUser")
  convsAsAgent  Conversation[]  @relation("convAgent")
  messages      Message[]

  @@index([role])
}

/// A device's FCM push token (one user can have several devices).
model DeviceToken {
  id        String   @id @default(uuid())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId    String
  token     String   @unique
  platform  String   @default("android")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
}

model RefreshToken {
  id        String   @id @default(uuid())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId    String
  tokenHash String
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([userId])
}

model Property {
  id      String @id @default(uuid())
  agent   User   @relation(fields: [agentId], references: [id], onDelete: Cascade)
  agentId String

  // Step 1 — basic
  title           String
  slug            String       @unique
  type            PropertyType @default(apartment)
  listingType     ListingType  @default(buy)
  description     String?
  price           Decimal      @default(0) @db.Decimal(14, 2)
  currency        String       @default("USD")
  priceNegotiable Boolean      @default(false)
  featured        Boolean      @default(false)

  // Step 2 — location
  country      String?
  state        String?
  city         String?
  locality     String?
  address      String?
  landmark     String?
  pincode      String?
  latitude     Float?
  longitude    Float?
  locationText String?

  // Step 3 — specifications
  bhk              Int?
  bathrooms        Int?
  balconies        Int?
  superBuiltUpArea Float?
  carpetArea       Float?
  plotArea         Float?
  floorNumber      Int?
  totalFloors      Int?
  propertyAge      String?
  furnishing       Furnishing?
  facing           Facing?

  // Step 4 — amenities
  amenities String[] @default([])

  // Step 5 — media
  imageUrls      String[] @default([])
  videoUrl       String?
  virtualTourUrl String?
  modelUrl       String?

  // Step 6 — owner / agent
  ownerName     String?
  ownerPhone    String?
  ownerWhatsapp String?
  ownerEmail    String?
  agencyName    String?

  // meta + verification
  status             PropertyStatus     @default(active)
  isVerified         Boolean            @default(false)
  verificationStatus VerificationStatus @default(pending)
  createdAt          DateTime           @default(now())
  updatedAt          DateTime           @updatedAt

  reels   Reel[]
  savedBy SavedProperty[]
  leads   Lead[]

  @@index([agentId])
  @@index([type])
  @@index([price])
  @@index([isVerified])
}

model Lead {
  id         String    @id @default(uuid())
  name       String
  email      String?
  phone      String?
  message    String?
  source     String    @default("website") // website | mobile
  status     String    @default("new") // new | contacted | closed
  property   Property? @relation(fields: [propertyId], references: [id], onDelete: SetNull)
  propertyId String?
  createdAt  DateTime  @default(now())

  @@index([source, createdAt])
  @@index([status])
}

model Reel {
  id             String    @id @default(uuid())
  agent          User      @relation(fields: [agentId], references: [id], onDelete: Cascade)
  agentId        String
  videoUrl       String
  thumbnailUrl   String?
  caption        String?
  property       Property? @relation(fields: [propertyId], references: [id], onDelete: SetNull)
  propertyId     String?
  isBoosted      Boolean   @default(false)
  boostExpiresAt DateTime?
  viewCount      Int       @default(0)
  likeCount      Int       @default(0)
  commentCount   Int       @default(0)
  createdAt      DateTime  @default(now())

  likes    Like[]
  comments Comment[]
  boosts   Boost[]

  @@index([agentId])
  @@index([isBoosted, createdAt])
}

model Like {
  reel      Reel     @relation(fields: [reelId], references: [id], onDelete: Cascade)
  reelId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId    String
  createdAt DateTime @default(now())

  @@id([reelId, userId])
}

model Comment {
  id        String   @id @default(uuid())
  reel      Reel     @relation(fields: [reelId], references: [id], onDelete: Cascade)
  reelId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId    String
  text      String
  createdAt DateTime @default(now())

  @@index([reelId, createdAt])
}

model Follow {
  follower   User     @relation("follower", fields: [followerId], references: [id], onDelete: Cascade)
  followerId String
  agent      User     @relation("agent", fields: [agentId], references: [id], onDelete: Cascade)
  agentId    String
  createdAt  DateTime @default(now())

  @@id([followerId, agentId])
  @@index([agentId])
}

model Conversation {
  id            String    @id @default(uuid())
  user          User      @relation("convUser", fields: [userId], references: [id], onDelete: Cascade)
  userId        String
  agent         User      @relation("convAgent", fields: [agentId], references: [id], onDelete: Cascade)
  agentId       String
  lastMessage   String?
  lastMessageAt DateTime?
  userReadAt    DateTime?
  agentReadAt   DateTime?
  createdAt     DateTime  @default(now())

  messages Message[]

  @@unique([userId, agentId])
}

model Message {
  id             String       @id @default(uuid())
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  conversationId String
  sender         User         @relation(fields: [senderId], references: [id], onDelete: Cascade)
  senderId       String
  text           String
  createdAt      DateTime     @default(now())

  @@index([conversationId, createdAt])
}

model SavedProperty {
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId     String
  property   Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  propertyId String
  createdAt  DateTime @default(now())

  @@id([userId, propertyId])
}

model Notification {
  id        String           @id @default(uuid())
  user      User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId    String
  type      NotificationType
  payload   Json             @default("{}")
  readAt    DateTime?
  createdAt DateTime         @default(now())

  @@index([userId, createdAt])
}

model Boost {
  id        String      @id @default(uuid())
  reel      Reel        @relation(fields: [reelId], references: [id], onDelete: Cascade)
  reelId    String
  agent     User        @relation(fields: [agentId], references: [id], onDelete: Cascade)
  agentId   String
  amount    Decimal     @default(0) @db.Decimal(10, 2)
  days      Int         @default(7)
  status    BoostStatus @default(pending)
  startsAt  DateTime?
  expiresAt DateTime?
  createdAt DateTime    @default(now())

  @@index([agentId])
  @@index([status])
}

model Subscription {
  id               String             @id @default(uuid())
  agent            User               @relation(fields: [agentId], references: [id], onDelete: Cascade)
  agentId          String             @unique
  plan             SubscriptionPlan   @default(free)
  status           SubscriptionStatus @default(active)
  currentPeriodEnd DateTime?
  createdAt        DateTime           @default(now())
  updatedAt        DateTime           @updatedAt
}

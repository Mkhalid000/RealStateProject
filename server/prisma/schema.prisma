generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  user
  agent
  admin
}

enum PropertyType {
  house
  apartment
  plot
  commercial
}

enum PropertyStatus {
  active
  sold
  rented
  draft
}

enum NotificationType {
  like
  comment
  message
  follow
  new_reel
}

enum SubscriptionPlan {
  free
  pro
  premium
}

enum BoostStatus {
  pending
  active
  expired
}

enum SubscriptionStatus {
  active
  cancelled
  expired
}

model User {
  id           String   @id @default(uuid())
  email        String   @unique
  passwordHash String
  role         UserRole @default(user)
  fullName     String?
  bio          String?
  avatarUrl    String?
  phone        String?
  socialLinks  Json?
  isVerified   Boolean  @default(false)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  properties     Property[]
  reels          Reel[]
  likes          Like[]
  comments       Comment[]
  following      Follow[]       @relation("follower")
  followers      Follow[]       @relation("agent")
  savedProps     SavedProperty[]
  notifications  Notification[]
  refreshTokens  RefreshToken[]
  boosts         Boost[]
  subscription   Subscription?
  convsAsUser    Conversation[] @relation("convUser")
  convsAsAgent   Conversation[] @relation("convAgent")
  messages       Message[]

  @@index([role])
}

model RefreshToken {
  id        String   @id @default(uuid())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId    String
  tokenHash String
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([userId])
}

model Property {
  id           String         @id @default(uuid())
  agent        User           @relation(fields: [agentId], references: [id], onDelete: Cascade)
  agentId      String
  title        String
  description  String?
  price        Decimal        @default(0) @db.Decimal(14, 2)
  currency     String         @default("USD")
  locationText String?
  latitude     Float?
  longitude    Float?
  type         PropertyType   @default(house)
  bedrooms     Int?
  bathrooms    Int?
  areaSqft     Float?
  amenities    String[]       @default([])
  imageUrls    String[]       @default([])
  status       PropertyStatus @default(active)
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt

  reels      Reel[]
  savedBy    SavedProperty[]

  @@index([agentId])
  @@index([type])
  @@index([price])
}

model Reel {
  id             String    @id @default(uuid())
  agent          User      @relation(fields: [agentId], references: [id], onDelete: Cascade)
  agentId        String
  videoUrl       String
  thumbnailUrl   String?
  caption        String?
  property       Property? @relation(fields: [propertyId], references: [id], onDelete: SetNull)
  propertyId     String?
  isBoosted      Boolean   @default(false)
  boostExpiresAt DateTime?
  likeCount      Int       @default(0)
  commentCount   Int       @default(0)
  createdAt      DateTime  @default(now())

  likes    Like[]
  comments Comment[]
  boosts   Boost[]

  @@index([agentId])
  @@index([isBoosted, createdAt])
}

model Like {
  reel      Reel     @relation(fields: [reelId], references: [id], onDelete: Cascade)
  reelId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId    String
  createdAt DateTime @default(now())

  @@id([reelId, userId])
}

model Comment {
  id        String   @id @default(uuid())
  reel      Reel     @relation(fields: [reelId], references: [id], onDelete: Cascade)
  reelId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId    String
  text      String
  createdAt DateTime @default(now())

  @@index([reelId, createdAt])
}

model Follow {
  follower   User     @relation("follower", fields: [followerId], references: [id], onDelete: Cascade)
  followerId String
  agent      User     @relation("agent", fields: [agentId], references: [id], onDelete: Cascade)
  agentId    String
  createdAt  DateTime @default(now())

  @@id([followerId, agentId])
  @@index([agentId])
}

model Conversation {
  id            String    @id @default(uuid())
  user          User      @relation("convUser", fields: [userId], references: [id], onDelete: Cascade)
  userId        String
  agent         User      @relation("convAgent", fields: [agentId], references: [id], onDelete: Cascade)
  agentId       String
  lastMessage   String?
  lastMessageAt DateTime?
  createdAt     DateTime  @default(now())

  messages Message[]

  @@unique([userId, agentId])
}

model Message {
  id             String       @id @default(uuid())
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  conversationId String
  sender         User         @relation(fields: [senderId], references: [id], onDelete: Cascade)
  senderId       String
  text           String
  createdAt      DateTime     @default(now())

  @@index([conversationId, createdAt])
}

model SavedProperty {
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId     String
  property   Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  propertyId String
  createdAt  DateTime @default(now())

  @@id([userId, propertyId])
}

model Notification {
  id        String           @id @default(uuid())
  user      User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId    String
  type      NotificationType
  payload   Json             @default("{}")
  readAt    DateTime?
  createdAt DateTime         @default(now())

  @@index([userId, createdAt])
}

model Boost {
  id        String      @id @default(uuid())
  reel      Reel        @relation(fields: [reelId], references: [id], onDelete: Cascade)
  reelId    String
  agent     User        @relation(fields: [agentId], references: [id], onDelete: Cascade)
  agentId   String
  amount    Decimal     @default(0) @db.Decimal(10, 2)
  days      Int         @default(7)
  status    BoostStatus @default(pending)
  startsAt  DateTime?
  expiresAt DateTime?
  createdAt DateTime    @default(now())

  @@index([agentId])
  @@index([status])
}

model Subscription {
  id               String             @id @default(uuid())
  agent            User               @relation(fields: [agentId], references: [id], onDelete: Cascade)
  agentId          String             @unique
  plan             SubscriptionPlan   @default(free)
  status           SubscriptionStatus @default(active)
  currentPeriodEnd DateTime?
  createdAt        DateTime           @default(now())
  updatedAt        DateTime           @updatedAt
}

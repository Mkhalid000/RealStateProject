VITE_API_URL=http://localhost:4000/api

# Google Maps — powers the /map explorer.
# 1. console.cloud.google.com -> enable "Maps JavaScript API"
# 2. Create an API key and restrict it to "Websites" (HTTP referrers) — this key
#    ships in the browser bundle, so an unrestricted key can be copied and billed
#    to you. Do NOT reuse the Android key from mobile/android/gradle.properties;
#    that one is fingerprint-restricted and will not work here.
VITE_GOOGLE_MAPS_API_KEY=

# Map ID is required for AdvancedMarker (custom price pins).
# Google Cloud -> Map Management -> create a Map ID (JavaScript / Vector).
# Falls back to Google's DEMO_MAP_ID, which works for local dev but shows a
# watermark and must not be used in production.
VITE_GOOGLE_MAPS_MAP_ID=
